{% extends "base.html" %}
{% block title %}Talis Push Jobs{% endblock %}

{% block content %}
<h1>Talis Push Jobs</h1>
<table class="table table-striped">
  <thead>
    <tr>
      <th>ID</th>
      <th>Created</th>
      <th>Title</th>
      <th>Status</th>
      <th>Resources</th>
      <th>Talis List URL</th>
      <th>Error</th>
      <th>Actions</th>
    </tr>
  </thead>
  <tbody>
    {% for job in jobs %}
    <tr>
      <td>{{ job.id }}</td>
      <td>{{ job.created_at|date:"Y-m-d H:i" }}</td>
      <td>{{ job.title|default:"—" }}</td>
      <td>
        <span class="badge 
          {% if job.status == 'completed' %}bg-success
          {% elif job.status == 'failed' %}bg-danger
          {% elif job.status == 'running' %}bg-primary
          {% else %}bg-secondary{% endif %}">
          {{ job.get_status_display }}
        </span>
      </td>
      <td>{{ job.resources.count }}</td>
      <td>
        {% if job.target_url %}
          <a href="{{ job.target_url }}" target="_blank">View list</a>
        {% else %}
          —
        {% endif %}
      </td>
      <td>{{ job.response_body|truncatechars:100 }}</td>
      <td>
        {% if job.status == 'failed' %}
          <a href="{% url 'resources:talis_retry_job' job.id %}" class="btn btn-sm btn-warning">Retry</a>
        {% endif %}
      </td>
    </tr>
    {% empty %}
    <tr><td colspan="8">No jobs yet.</td></tr>
    {% endfor %}
  </tbody>
</table>
<a href="{% url 'resources:dashboard' %}" class="btn btn-secondary">Back to Dashboard</a>
{% endblock %}